# Public base URL of this server, no trailing slash.
BASE_URL=https://example.com
PORT=8000

# Initial private deployment: use "none" only behind Secure MCP Tunnel.
MCP_AUTH_MODE=none
# Optional static bearer mode for non-ChatGPT/private clients.
MCP_BEARER_TOKEN=

# Google OAuth 2.0 web client created in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback

# Random 32-byte key encoded as base64, used to AES-GCM encrypt refresh tokens in KV.
TOKEN_ENCRYPTION_KEY_BASE64=

# Optional bootstrap refresh token. Prefer completing /auth/google/start instead.
GOOGLE_REFRESH_TOKEN=

# Protects the one-time Google account linking endpoint. Generate a long random value.
ADMIN_SETUP_TOKEN=

# Optional additional Google OAuth scopes needed by functions invoked via scripts.run.
# Example: https://www.googleapis.com/auth/spreadsheets
GOOGLE_EXTRA_SCOPES=

# Durable token storage path for self-hosted/Docker deployments.
DENO_KV_PATH=./data/google-apps-script-mcp.sqlite3
